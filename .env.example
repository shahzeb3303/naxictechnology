# Contact form delivery.
#
# Copy to .env.local for local development, and set the same values in
# Vercel under Project Settings, Environment Variables, for Production.
#
# Without RESEND_API_KEY the endpoint returns 503 and the form tells the
# visitor to email us directly. It never claims a message was sent.

# Required. Create at https://resend.com/api-keys
RESEND_API_KEY=

# Optional. Defaults to site.email in src/lib/data.ts
CONTACT_TO=info@nexictechnologies.com

# Optional. The sending identity.
# The domain here must be verified in Resend first, at
# https://resend.com/domains. Until nexictechnologies.com is verified, leave
# this unset and Resend's shared onboarding@resend.dev sender is used, which
# works for testing but should not be used in production.
# CONTACT_FROM="Nexic Technologies Website <website@nexictechnologies.com>"
